{
  "description": "Refund part or all of one order.",
  "effects": [
    {
      "after": [],
      "id": "debit",
      "kind": "update",
      "parameters": {
        "amount": "$.amount",
        "order_id": "$.order_id"
      },
      "stated_rows": 1,
      "statement": "UPDATE orders SET total = total - CAST(:amount AS NUMERIC) WHERE id = :order_id",
      "table": "orders"
    },
    {
      "after": [
        "debit"
      ],
      "id": "record",
      "kind": "insert",
      "parameters": {
        "amount": "$.amount",
        "order_id": "$.order_id"
      },
      "stated_rows": 1,
      "statement": "INSERT INTO refunds (order_id, tenant, amount) SELECT id, tenant, :amount FROM orders WHERE id = :order_id",
      "table": "refunds"
    }
  ],
  "input": {
    "additionalProperties": false,
    "properties": {
      "amount": {
        "pattern": "^[0-9]{1,6}\\.[0-9]{2}$",
        "type": "string"
      },
